digraph G {
  graph [fontname="Arial", fontsize=12, bgcolor="white", rankdir=TB, nodesep=0.35, ranksep=0.55, splines=true, concentrate=false];
  node [fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#333333"];
  node [shape=plain];
  "Entreprise" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Entreprise</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idEntreprise<BR/>nom<BR/>nif<BR/>stat<BR/>devise</TD></TR></TABLE>>];
  "PlanComptable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>PlanComptable</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idPlan<BR/>nom<BR/>pays</TD></TR></TABLE>>];
  "CompteComptable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>CompteComptable</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">numeroCompte<BR/>libelle<BR/>classe</TD></TR></TABLE>>];
  "Utilisateur" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Utilisateur</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idUtilisateur<BR/>nom<BR/>email<BR/>role</TD></TR></TABLE>>];
  "Facture" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Facture</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idFacture<BR/>numeroFacture<BR/>dateFacture<BR/>typeFacture<BR/>devise<BR/>montantHT<BR/>montantTVA<BR/>montantTTC<BR/>statut</TD></TR></TABLE>>];
  "Document" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Document</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idDocument<BR/>nomFichier<BR/>typeFichier<BR/>taille<BR/>chemin</TD></TR></TABLE>>];
  "Fournisseur" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Fournisseur</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idFournisseur<BR/>raisonSociale<BR/>adresse<BR/>nif<BR/>stat</TD></TR></TABLE>>];
  "Client" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Client</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idClient<BR/>raisonSociale<BR/>adresse<BR/>nif</TD></TR></TABLE>>];
  "TauxChange" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>TauxChange</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idTaux<BR/>devise<BR/>taux<BR/>dateEffet</TD></TR></TABLE>>];
  "TraitementOCR" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>TraitementOCR</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idOCR<BR/>moteur<BR/>texteExtrait<BR/>scoreConfiance<BR/>dateTraitement</TD></TR></TABLE>>];
  "InformationExtraite" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>InformationExtraite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idInformation<BR/>typeInformation<BR/>valeur<BR/>scoreConfiance</TD></TR></TABLE>>];
  "Analyse" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Analyse</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idAnalyse<BR/>natureOperation<BR/>scoreConfiance</TD></TR></TABLE>>];
  "ModeleIA" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>ModeleIA</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idModele<BR/>version<BR/>algorithme<BR/>f1Score<BR/>actif</TD></TR></TABLE>>];
  "PredictionCompte" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>PredictionCompte</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idPrediction<BR/>numeroComptePropose<BR/>scoreConfiance</TD></TR></TABLE>>];
  "RegleComptable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>RegleComptable</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idRegle<BR/>natureOperation<BR/>comptesCandidats<BR/>condition</TD></TR></TABLE>>];
  "EcritureComptable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>EcritureComptable</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idEcriture<BR/>dateEcriture<BR/>statut<BR/>totalDebit<BR/>totalCredit<BR/>scoreConfiance</TD></TR></TABLE>>];
  "LigneEcriture" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>LigneEcriture</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idLigne<BR/>libelle<BR/>montantDebit<BR/>montantCredit</TD></TR></TABLE>>];
  "Validation" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Validation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idValidation<BR/>decision<BR/>commentaire<BR/>dateValidation<BR/>validePar</TD></TR></TABLE>>];
  "Correction" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Correction</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idCorrection<BR/>champ<BR/>ancienneValeur<BR/>nouvelleValeur<BR/>dateCorrection<BR/>auteur</TD></TR></TABLE>>];
  "Historique" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Historique</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">idHistorique<BR/>action<BR/>description<BR/>dateAction<BR/>auteur</TD></TR></TABLE>>];
  "Entreprise" -> "Utilisateur" [dir=none, label="emploie", taillabel="1", headlabel="1..*", labeldistance=1.6, labelangle=30];
  "Entreprise" -> "PlanComptable" [dir=none, label="choisit", taillabel="0..*", headlabel="1", labeldistance=1.6, labelangle=30];
  "PlanComptable" -> "CompteComptable" [dir=back, arrowtail=diamond, label="contient", taillabel="1", headlabel="1..*", labeldistance=1.6, labelangle=30];
  "Entreprise" -> "Facture" [dir=none, label="possède", taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=30];
  "Utilisateur" -> "Facture" [dir=none, label="importe", taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=30];
  "Facture" -> "Document" [dir=back, arrowtail=diamond, label="est stockée dans", taillabel="1", headlabel="1", labeldistance=1.6, labelangle=30];
  "Facture" -> "Fournisseur" [dir=none, label="émise par", taillabel="0..*", headlabel="1", labeldistance=1.6, labelangle=30];
  "Facture" -> "Client" [dir=none, label="adressée à", taillabel="0..*", headlabel="0..1", labeldistance=1.6, labelangle=30];
  "Facture" -> "TauxChange" [dir=none, label="convertie selon", taillabel="0..*", headlabel="0..1", labeldistance=1.6, labelangle=30];
  "Facture" -> "TraitementOCR" [dir=none, label="subit", taillabel="1", headlabel="1", labeldistance=1.6, labelangle=30];
  "TraitementOCR" -> "InformationExtraite" [dir=back, arrowtail=diamond, label="produit", taillabel="1", headlabel="1..*", labeldistance=1.6, labelangle=30];
  "Facture" -> "Analyse" [dir=none, label="fait l'objet de", taillabel="1", headlabel="0..1", labeldistance=1.6, labelangle=30];
  "Analyse" -> "PredictionCompte" [dir=back, arrowtail=diamond, label="propose", taillabel="1", headlabel="1..*", labeldistance=1.6, labelangle=30];
  "ModeleIA" -> "PredictionCompte" [dir=none, label="produit", taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=30];
  "Analyse" -> "RegleComptable" [dir=none, label="applique", taillabel="0..*", headlabel="1", labeldistance=1.6, labelangle=30];
  "RegleComptable" -> "CompteComptable" [dir=none, label="autorise", taillabel="0..*", headlabel="1..*", labeldistance=1.6, labelangle=30];
  "PredictionCompte" -> "CompteComptable" [dir=none, label="désigne", taillabel="0..*", headlabel="1", labeldistance=1.6, labelangle=30];
  "Facture" -> "EcritureComptable" [dir=none, label="génère", taillabel="1", headlabel="0..1", labeldistance=1.6, labelangle=30];
  "EcritureComptable" -> "LigneEcriture" [dir=back, arrowtail=diamond, label="contient", taillabel="1", headlabel="2..*", labeldistance=1.6, labelangle=30];
  "LigneEcriture" -> "CompteComptable" [dir=none, label="imputée sur", taillabel="0..*", headlabel="1", labeldistance=1.6, labelangle=30];
  "EcritureComptable" -> "Validation" [dir=none, label="fait l'objet de", taillabel="1", headlabel="0..1", labeldistance=1.6, labelangle=30];
  "EcritureComptable" -> "Correction" [dir=none, label="peut subir", taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=30];
  "Correction" -> "ModeleIA" [dir=none, label="alimente", taillabel="0..*", headlabel="0..1", labeldistance=1.6, labelangle=30];
  "Facture" -> "Historique" [dir=none, label="trace", taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=30];

}