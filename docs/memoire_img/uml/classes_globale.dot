digraph G {
  graph [fontname="Arial", fontsize=12, bgcolor="white", rankdir=TB, nodesep=0.3, ranksep=0.45, splines=true];
  node [fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#333333"];
  node [shape=plain];
  "Analyse" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Analyse</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idAnalyse : int<BR/>-natureOperation : String<BR/>-scoreConfiance : Decimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+classerOperation() : String</TD></TR></TABLE>>];
  "AnalyseNLP" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>AnalyseNLP</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-langue : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+detecterLangue() : String<BR/>+extraireEntites() : List<BR/>+identifierFournisseur() : String</TD></TR></TABLE>>];
  "Client" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Client</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idClient : int<BR/>-raisonSociale : String<BR/>-adresse : String<BR/>-nif : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"> </TD></TR></TABLE>>];
  "CompteComptable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>CompteComptable</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-numeroCompte : String<BR/>-libelle : String<BR/>-classe : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"> </TD></TR></TABLE>>];
  "Correction" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Correction</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idCorrection : int<BR/>-champ : String<BR/>-ancienneValeur : String<BR/>-nouvelleValeur : String<BR/>-dateCorrection : DateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+enregistrer() : void</TD></TR></TABLE>>];
  "Document" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Document</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idDocument : int<BR/>-nomFichier : String<BR/>-typeFichier : String<BR/>-taille : int<BR/>-chemin : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+verifierFormat() : Boolean</TD></TR></TABLE>>];
  "EcritureComptable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>EcritureComptable</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idEcriture : int<BR/>-dateEcriture : Date<BR/>-statut : String<BR/>-totalDebit : Decimal<BR/>-totalCredit : Decimal<BR/>-scoreConfiance : Decimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+ajouterLigne(l : LigneEcriture) : void<BR/>+calculerScore() : Decimal<BR/>+valider() : void</TD></TR></TABLE>>];
  "Entreprise" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Entreprise</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idEntreprise : int<BR/>-nom : String<BR/>-nif : String<BR/>-stat : String<BR/>-devise : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+choisirPlan(p : PlanComptable) : void</TD></TR></TABLE>>];
  "Facture" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Facture</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idFacture : int<BR/>-numeroFacture : String<BR/>-dateFacture : Date<BR/>-typeFacture : String<BR/>-devise : String<BR/>-montantHT : Decimal<BR/>-montantTVA : Decimal<BR/>-montantTTC : Decimal<BR/>-statut : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+importer(fichier : Document) : void<BR/>+consulter() : Facture<BR/>+supprimer() : void</TD></TR></TABLE>>];
  "Fournisseur" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Fournisseur</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idFournisseur : int<BR/>-raisonSociale : String<BR/>-adresse : String<BR/>-nif : String<BR/>-stat : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"> </TD></TR></TABLE>>];
  "Historique" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Historique</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idHistorique : int<BR/>-action : String<BR/>-description : String<BR/>-dateAction : DateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+enregistrer(action : String) : void</TD></TR></TABLE>>];
  "InformationExtraite" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>InformationExtraite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idInformation : int<BR/>-typeInformation : String<BR/>-valeur : String<BR/>-scoreConfiance : Decimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"> </TD></TR></TABLE>>];
  "LigneEcriture" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>LigneEcriture</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idLigne : int<BR/>-libelle : String<BR/>-montantDebit : Decimal<BR/>-montantCredit : Decimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"> </TD></TR></TABLE>>];
  "ModeleIA" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>ModeleIA</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idModele : int<BR/>-version : String<BR/>-algorithme : String<BR/>-f1Score : Decimal<BR/>-actif : Boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+predire(texte : String) : PredictionCompte<BR/>+entrainer() : void<BR/>+evaluer() : Decimal</TD></TR></TABLE>>];
  "MoteurComptable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>MoteurComptable</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+appliquerRegles(a : Analyse) : void<BR/>+genererEcriture() : EcritureComptable<BR/>+verifierEquilibre() : Boolean</TD></TR></TABLE>>];
  "PlanComptable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>PlanComptable</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idPlan : int<BR/>-nom : String<BR/>-pays : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+rechercherCompte(numero : String) : CompteComptable</TD></TR></TABLE>>];
  "PredictionCompte" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>PredictionCompte</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idPrediction : int<BR/>-numeroComptePropose : String<BR/>-scoreConfiance : Decimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"> </TD></TR></TABLE>>];
  "Pretraitement" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Pretraitement</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-resolution : int<BR/>-netteteMesuree : Decimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+redresser() : void<BR/>+debruiter() : void<BR/>+binariser() : void</TD></TR></TABLE>>];
  "RegleComptable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>RegleComptable</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idRegle : int<BR/>-natureOperation : String<BR/>-comptesCandidats : List<BR/>-condition : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+verifier(compte : String) : Boolean</TD></TR></TABLE>>];
  "Role" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Role</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idRole : int<BR/>-nom : String<BR/>-description : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+attribuer(u : Utilisateur) : void</TD></TR></TABLE>>];
  "TauxChange" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>TauxChange</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idTaux : int<BR/>-devise : String<BR/>-taux : Decimal<BR/>-dateEffet : Date</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+convertir(montant : Decimal) : Decimal</TD></TR></TABLE>>];
  "TraitementAutomatique" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>TraitementAutomatique</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-etapeCourante : String<BR/>-dateDebut : DateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+lancer(f : Facture) : void<BR/>+reprendre() : void</TD></TR></TABLE>>];
  "TraitementOCR" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>TraitementOCR</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idOCR : int<BR/>-moteur : String<BR/>-texteExtrait : Text<BR/>-scoreConfiance : Decimal<BR/>-dureeMs : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+extraireTexte() : String<BR/>+basculerMoteurSecours() : void</TD></TR></TABLE>>];
  "Utilisateur" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Utilisateur</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idUtilisateur : int<BR/>-nom : String<BR/>-email : String<BR/>-motDePasse : String<BR/>-actif : Boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+sAuthentifier() : Boolean<BR/>+seDeconnecter() : void</TD></TR></TABLE>>];
  "Validation" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2F4B6B" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF5" CELLPADDING="4"><B>Validation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-idValidation : int<BR/>-decision : String<BR/>-commentaire : String<BR/>-dateValidation : DateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+valider() : void<BR/>+rejeter() : void</TD></TR></TABLE>>];
  "Utilisateur" -> "Role" [dir=none, label="possède", taillabel="0..*", headlabel="1", labeldistance=1.6, labelangle=30];
  "Utilisateur" -> "Facture" [dir=none, label="importe", taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=30];
  "Facture" -> "Document" [dir=back, arrowtail=diamond, label="est stockée dans", taillabel="1", headlabel="1", labeldistance=1.6, labelangle=30];
  "Facture" -> "Fournisseur" [dir=none, label="émise par", taillabel="0..*", headlabel="1", labeldistance=1.6, labelangle=30];
  "Facture" -> "Client" [dir=none, label="adressée à", taillabel="0..*", headlabel="0..1", labeldistance=1.6, labelangle=30];
  "TraitementAutomatique" -> "Facture" [dir=none, label="traite", taillabel="0..*", headlabel="1", labeldistance=1.6, labelangle=30];
  "TraitementAutomatique" -> "Pretraitement" [dir=back, arrowtail=diamond, label="étape 1", taillabel="1", headlabel="1", labeldistance=1.6, labelangle=30];
  "TraitementAutomatique" -> "TraitementOCR" [dir=back, arrowtail=diamond, label="étape 2", taillabel="1", headlabel="1", labeldistance=1.6, labelangle=30];
  "TraitementOCR" -> "InformationExtraite" [dir=back, arrowtail=diamond, label="produit", taillabel="1", headlabel="1..*", labeldistance=1.6, labelangle=30];
  "TraitementAutomatique" -> "AnalyseNLP" [dir=back, arrowtail=diamond, label="étape 3", taillabel="1", headlabel="1", labeldistance=1.6, labelangle=30];
  "AnalyseNLP" -> "InformationExtraite" [style=dashed, arrowhead=vee, label="exploite", headlabel="1..*", labeldistance=1.6, labelangle=30];
  "AnalyseNLP" -> "Analyse" [dir=none, label="produit", taillabel="1", headlabel="1", labeldistance=1.6, labelangle=30];
  "Analyse" -> "ModeleIA" [dir=none, label="utilise", taillabel="0..*", headlabel="1", labeldistance=1.6, labelangle=30];
  "ModeleIA" -> "PredictionCompte" [dir=none, label="produit", taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=30];
  "PredictionCompte" -> "CompteComptable" [dir=none, label="désigne", taillabel="0..*", headlabel="1", labeldistance=1.6, labelangle=30];
  "MoteurComptable" -> "Analyse" [style=dashed, arrowhead=vee, label="exploite", labeldistance=1.6, labelangle=30];
  "MoteurComptable" -> "RegleComptable" [style=dashed, arrowhead=vee, label="applique", headlabel="1..*", labeldistance=1.6, labelangle=30];
  "RegleComptable" -> "CompteComptable" [dir=none, label="autorise", taillabel="0..*", headlabel="1..*", labeldistance=1.6, labelangle=30];
  "MoteurComptable" -> "EcritureComptable" [style=dashed, arrowhead=vee, label="génère", labeldistance=1.6, labelangle=30];
  "Facture" -> "EcritureComptable" [dir=none, label="donne lieu à", taillabel="1", headlabel="0..1", labeldistance=1.6, labelangle=30];
  "EcritureComptable" -> "LigneEcriture" [dir=back, arrowtail=diamond, label="contient", taillabel="1", headlabel="2..*", labeldistance=1.6, labelangle=30];
  "LigneEcriture" -> "CompteComptable" [dir=none, label="imputée sur", taillabel="0..*", headlabel="1", labeldistance=1.6, labelangle=30];
  "EcritureComptable" -> "Validation" [dir=none, label="fait l'objet de", taillabel="1", headlabel="0..1", labeldistance=1.6, labelangle=30];
  "EcritureComptable" -> "Correction" [dir=none, label="peut subir", taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=30];
  "Facture" -> "Historique" [dir=none, label="trace", taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=30];
  "Entreprise" -> "Utilisateur" [dir=none, label="emploie", taillabel="1", headlabel="1..*", labeldistance=1.6, labelangle=30];
  "Entreprise" -> "PlanComptable" [dir=none, label="choisit", taillabel="0..*", headlabel="1", labeldistance=1.6, labelangle=30];
  "PlanComptable" -> "CompteComptable" [dir=back, arrowtail=diamond, label="contient", taillabel="1", headlabel="1..*", labeldistance=1.6, labelangle=30];
  "Entreprise" -> "Facture" [dir=none, label="possède", taillabel="1", headlabel="0..*", labeldistance=1.6, labelangle=30];
  "Facture" -> "TauxChange" [dir=none, label="convertie selon", taillabel="0..*", headlabel="0..1", labeldistance=1.6, labelangle=30];
  "Correction" -> "ModeleIA" [dir=none, label="alimente", taillabel="0..*", headlabel="0..1", labeldistance=1.6, labelangle=30];

}