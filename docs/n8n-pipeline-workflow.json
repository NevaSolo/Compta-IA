    },
    {
      "parameters": {
        "content": "### Apercu visuel\nCe dernier noeud telecharge l'image/PDF original de la facture (GET /api/invoices/{id}/file) en tant que fichier binaire : n8n en affiche automatiquement une miniature dans le panneau de resultats.",
        "height": 200,
        "width": 320
      },
      "id": "b1a1a1a1-0015-4a11-8a11-000000000015",
      "name": "Note - Apercu visuel",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1080,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const entries = Array.isArray($json) ? $json : [$json];\nconst entry = entries[0];\nconst lines = entry.lines || [];\nconst fmt = (n) => Number(n || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nconst totalDebit = lines.reduce((s, l) => s + Number(l.debit || 0), 0);\nconst totalCredit = lines.reduce((s, l) => s + Number(l.credit || 0), 0);\n\nconst rowsHtml = lines.map((l) => `\n  <tr>\n    <td>${l.account_code}</td>\n    <td>${l.label}</td>\n    <td class=\"num\">${l.debit && Number(l.debit) > 0 ? fmt(l.debit) : ''}</td>\n    <td class=\"num\">${l.credit && Number(l.credit) > 0 ? fmt(l.credit) : ''}</td>\n  </tr>`).join('');\n\nconst html = `<!DOCTYPE html>\n<html lang=\"fr\"><head><meta charset=\"utf-8\">\n<title>Ecriture comptable - ${entry.label}</title>\n<style>\n  body { font-family: Arial, sans-serif; margin: 2rem; color: #1e293b; }\n  h1 { font-size: 1.1rem; margin-bottom: .2rem; }\n  .meta { color: #64748b; font-size: .85rem; margin-bottom: 1rem; }\n  table { border-collapse: collapse; width: 100%; font-size: .9rem; }\n  th, td { border: 1px solid #cbd5e1; padding: 8px 10px; text-align: left; }\n  th { background: #f1f5f9; }\n  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }\n  tfoot td { font-weight: bold; background: #f8fafc; }\n  .badge { display:inline-block; padding:2px 8px; border-radius:999px; background:#fef3c7; color:#92400e; font-size:.75rem; }\n</style></head>\n<body>\n  <h1>Ecriture comptable propos&eacute;e</h1>\n  <p class=\"meta\">${entry.label} &mdash; ${entry.entry_date} &mdash;\n     statut <span class=\"badge\">${entry.status}</span> &mdash;\n     confiance ${Math.round((entry.confidence_score || 0) * 100)}%</p>\n  <table>\n    <thead><tr><th>Compte</th><th>Libelle</th><th class=\"num\">Debit</th><th class=\"num\">Credit</th></tr></thead>\n    <tbody>${rowsHtml}</tbody>\n    <tfoot><tr><td colspan=\"2\">TOTAL</td><td class=\"num\">${fmt(totalDebit)}</td><td class=\"num\">${fmt(totalCredit)}</td></tr></tfoot>\n  </table>\n</body></html>`;\n\nreturn [{ json: { html, entryId: entry.id }, binary: {\n  data: {\n    data: Buffer.from(html, 'utf-8').toString('base64'),\n    mimeType: 'text/html',\n    fileName: `ecriture-${entry.id}.html`\n  }\n}}];"
      },
      "id": "b1a1a1a1-0016-4a11-8a11-000000000016",
