# Copier ce fichier vers .env et adapter les valeurs

# Base de données MySQL 8
DATABASE_URL=mysql+pymysql://compta_user:compta_pass@localhost:3306/compta_ia_db

# Sécurité JWT (générer une clé : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Stockage des fichiers
UPLOAD_DIR=./storage/uploads
MODELS_DIR=./storage/models

# OCR
OCR_LANGUAGES=fr,en
OCR_FALLBACK_THRESHOLD=0.55
OCR_REJECT_THRESHOLD=0.40

# TVA par défaut (PCG malgache, taux normal)
DEFAULT_VAT_RATE=0.20
DEFAULT_CURRENCY=MGA

# Réentraînement
RETRAIN_CORRECTION_THRESHOLD=50
