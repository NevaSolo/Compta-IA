# Copier ce fichier en ".env" (même dossier que docker-compose.yml) et
# renseigner des valeurs réelles avant de lancer "docker compose up -d".
# Ne jamais committer le fichier ".env" réel dans Git.

# Mot de passe du compte root MySQL (choisissez une valeur forte et unique)
MYSQL_ROOT_PASSWORD=change-moi-mot-de-passe-fort

# Clé secrète applicative (signature des jetons JWT) — générez-la avec :
#   openssl rand -hex 32
SECRET_KEY=change-moi-avec-openssl-rand-hex-32
